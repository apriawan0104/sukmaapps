  "Repository implementation (data)": {
    "scope": "dart",
    "prefix": "reimp",
    "body": [
      "import 'package:app_core/app_core.dart';",
      "import 'package:injectable/injectable.dart';",
      "",
      "import '../../domain/entity/entity.dart';",
      "import '../../domain/param/param.dart';",
      "import '../../domain/repository/${2:feature}.repository.dart';",
      "import '../datasource/datasource.dart';",
      "",
      "@LazySingleton(as: ${1:Feature}Repository)",
      "class ${1:Feature}ImplRepository implements ${1:Feature}Repository {",
      "  ${1:Feature}ImplRepository(this._remoteDataSource);",
      "",
