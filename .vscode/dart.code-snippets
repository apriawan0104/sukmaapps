  "Remote datasource implementation": {
    "scope": "dart",
    "prefix": "dsimp",
    "body": [
      "import 'package:app_core/app_core.dart';",
      "import 'package:injectable/injectable.dart';",
      "",
      "import '../../../domain/param/param.dart';",
      "import '../../model/model.dart';",
      "import '${2:feature}_remote.datasource.dart';",
      "",
      "@LazySingleton(as: ${1:Feature}RemoteDataSource)",
      "class ${1:Feature}RemoteImplDataSource implements ${1:Feature}RemoteDataSource {",
      "  ${1:Feature}RemoteImplDataSource(this._remoteClient);",
      "",
      "  final HttpClient _remoteClient;",
      "",
      "  @override",
      "  Future<ValueGuard<List<${3:Item}Model>>> getList${4:Items}(",
      "    NoParams params,",
      "  ) async {",
      "    return _remoteClient.get<List<dynamic>>(",
      "      '/${5:endpointPath}',",
      "      queryParameters: const {'ver': 'v1'},",
      "    ).mapSuccess((response) {",
      "      final items = response.data ?? <dynamic>[];",
      "      return items",
      "          .map((e) => ${3:Item}Model.fromJson(e as Map<String, dynamic>))",
      "          .toList();",
      "    });",
      "  }",
      "",
      "  @override",
      "  Future<ValueGuard<${6:Data}Model>> get${6:Data}(${7:Param} params) async {",
      "    return _remoteClient.get<Map<String, dynamic>>(",
      "      '/${8:endpointPath}',",
      "      queryParameters: const {'ver': 'v1'},",
      "    ).mapSuccess(",
      "      (response) => ${6:Data}Model.fromJson(",
      "        response.data ?? <String, dynamic>{},",
      "      ),",
      "    );",
      "  }",
      "",
      "  $0",
      "}"
    ],
    "description": "Remote DataSource impl: GET list + GET satu model; chain .mapSuccess pada Future<Either<...>> (app_core)."
  },
