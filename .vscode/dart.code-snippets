      "",
      "  @override",
      "  Future<ValueGuard<List<${3:Item}Entity>>> getList${4:Items}(",
      "    ${5:NoParams} params,",
      "  ) async {",
      "    final result = await _remoteDataSource.getList${4:Items}(params);",
      "    return result.mapListValue(",
      "      (item) => item.toEntity(),",
      "    );",
      "  }",
      "",
      "  @override",
      "  Future<ValueGuard<${6:Item}Entity>> get${6:Item}(${7:Param} params) async {",
      "    final result = await _remoteDataSource.get${6:Item}(params);",
      "    return result.mapValue(",
      "      (model) => model.toEntity(),",
      "    );",
      "  }",
      "",
      "  $0",
      "}"
    ],
    "description": "Repository impl: contoh return List pakai mapListValue + satu Entity pakai mapValue. Deklarasikan signature di reabs dan sesuaikan datasource/model"
  },
