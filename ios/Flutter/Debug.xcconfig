#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements

// Reversed OAuth client id from config/<flavor>/GoogleService-Info.plist, registered as a
// URL scheme in Info.plist so Google Sign In can receive its callback. The unflavored
// Debug/Release/Profile configs build the prd bundle id, so they default to prd.
FIREBASE_REVERSED = com.googleusercontent.apps.933792903721-np2fra6tqggloa06iq9sbjfrm9fitieo
